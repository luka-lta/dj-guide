{
  "expo": {
    "name": "DJ Guide",
    "slug": "pioneer-guide-app",
    "scheme": "pioneer-guide",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.luka-lta.dj-guide",
      "icon": {
        "light": "./assets/DJ_GUDE_WHITE.jpg",
        "dark": "./assets/DJ_GUIDE_DARK.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.luka_lta.dj_guide",
      "icon": "./assets/DJ_GUIDE_DARK.png",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0dff932b-e127-4e5c-9640-f9c586d1f258"
      }
    }
  }
}
