{
  "expo": {
    "name": "DJ Guide",
    "slug": "pioneer-guide-app",
    "scheme": "pioneer-guide",
    "version": "0.6.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.luka-lta.dj-guide",
      "googleServicesFile": "./GoogleService-Info.plist",
      "icon": {
        "light": "./assets/DJ_GUDE_WHITE.jpg",
        "dark": "./assets/DJ_GUIDE_DARK.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.luka_lta.dj_guide",
      "icon": "./assets/DJ_GUIDE_DARK.png",
      "predictiveBackGestureEnabled": false
    },
    "locales": {
      "de": "./locales/de.json",
      "en": "./locales/en.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3346959869225055~6261637072",
          "userTrackingUsageDescription": "Lets us show you more relevant ads and keep the app free."
        }
      ],
      "expo-localization",
      "expo-iap",
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "./plugins/withFirebaseSPMFix",
      "./plugins/withPodsDeploymentTarget"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0dff932b-e127-4e5c-9640-f9c586d1f258"
      }
    }
  }
}
